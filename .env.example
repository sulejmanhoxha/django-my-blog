# Django reads these from the process environment (it does not load this file).
# Export them in your shell or set them in your host (for example Vercel).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Optional: path of the SQLite file (default: ./db.sqlite3)
DJANGO_SQLITE_PATH=
# Optional: set POSTGRES_HOST to use PostgreSQL instead of SQLite
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
